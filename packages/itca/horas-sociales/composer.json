{
    "name": "itca/horas-sociales",
    "description": "Módulo de registro de horas sociales (Servicio Social Estudiantil) de ITCA-FEPADE para Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Itca\\HorasSociales\\": "src/",
            "Itca\\HorasSociales\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Itca\\HorasSociales\\HorasSocialesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
